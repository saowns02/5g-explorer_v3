# Settings shared by every OpenStack script. Edit here, not in the scripts.
# Source an openrc for the right project before running anything:
#   source ~/devstack/openrc admin admin      (keystone.sh, image.sh)
#   source deploy/openstack/openrc-5g-prod    (everything else, written by keystone.sh)

# Projects (tenants). prod runs the app; dev shows a second, isolated tenant.
PROD_PROJECT=5g-prod
DEV_PROJECT=5g-dev

# Glance image built by image.sh (Ubuntu 24.04 with every package pre-installed).
UBUNTU_RELEASE=noble
IMAGE_NAME=5g-explorer-ubuntu-24.04
SSH_USER=ubuntu
KEY_NAME=5g-explorer-key
SSH_KEY="${SSH_KEY:-$HOME/.ssh/5g-explorer}"

# Flavours. Native caps in deploy/native/setup.sh (CAP=1) match these.
FLAVOR_WEB=5g.web   ; FLAVOR_WEB_VCPU=1 ; FLAVOR_WEB_RAM=1024 ; FLAVOR_WEB_DISK=10
FLAVOR_API=5g.api   ; FLAVOR_API_VCPU=2 ; FLAVOR_API_RAM=2048 ; FLAVOR_API_DISK=10
FLAVOR_DB=5g.db     ; FLAVOR_DB_VCPU=2  ; FLAVOR_DB_RAM=4096  ; FLAVOR_DB_DISK=10

# Neutron. EXT_NET is DevStack's default external network.
EXT_NET=public
ROUTER=5g-router
WEB_NET=5g-web-net     ; WEB_SUBNET=5g-web-subnet     ; WEB_CIDR=10.0.1.0/24
APP_NET=5g-app-net     ; APP_SUBNET=5g-app-subnet     ; APP_CIDR=10.0.2.0/24
DNS_SERVER=8.8.8.8

# Security groups.
SG_WEB=5g-sg-web ; SG_API=5g-sg-api ; SG_DB=5g-sg-db

# Instances.
VM_WEB=5g-web ; VM_API=5g-api ; VM_DB=5g-db

# Cinder volume holding the PostgreSQL data directory.
DB_VOLUME=5g-pgdata
DB_VOLUME_GB=10
PGDATA_MOUNT=/mnt/pgdata

# App ports.
API_PORT=8000
DB_NAME=fiveg
DB_USER=fiveg

# Written by provision.sh, read by deploy.sh, recover-db.sh, scale-api.sh and Jenkins.
INVENTORY="${INVENTORY:-$HOME/.5g-explorer/inventory.env}"
SECRETS_DIR="${SECRETS_DIR:-$HOME/.5g-explorer}"
